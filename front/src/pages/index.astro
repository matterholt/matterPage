---
import Base from "@layouts/Base.astro";
import SectionBlurb from "@layouts/SectionBlurb.astro";
import Text from "../components/base/text/Text.astro";
import LinkTo from "../components/base/linkTo/LinkTo.astro";
import CurrentCareerPosition from "../components/custom/CurrentCareerPosition.astro";
// import JobAccomplishments from "../components/custom/JobAccomplishments.astro";

import Section from "../layouts/component/Section.astro";
---

<Base title="Software Developer">
  <div class="mainContent_layout" slot="mainContent">
    <Text tag="p">
      A software developer with over 4 years of professional development, I've
      transitioned from being an automotive engineer for 10 plus years. Started
      with writing Python script and automations for collecting results and
      generating reports. Specialized in Front end development to build user
      intuitive UI's for data collections projects. Used HTML/CSS, along with
      React and Vue, and Svealte. Used Node with Typescripts for backend and
      general scripting for projects. I bring the same precision and
      problem-solving discipline from engineering to every project.
      Stack-agnostic and adaptable, seeking a role where I can take ownership of
      a project and work alongside a team to deliver results.
    </Text>
  </div>
</Base>
